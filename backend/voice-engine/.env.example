# Optional settings for the voice engine (`voice-engine`). Nothing here is required: every value has a default.
# voice-engine reads them from the process environment; export them in your shell, e.g. `set -a; . ./.env; set +a`.

# Where model weights live (default: <project>/models).
# VOICE_ENGINE_MODELS_DIR=

# Where Voice Studio keeps saved voices (default: <project>/data/voices). Private: never commit this folder.
# VOICE_ENGINE_VOICES_DIR=

# Default model profile and persona for `run` / `serve`.
# VOICE_ENGINE_PROFILE=fast
# VOICE_ENGINE_PERSONA=assistant

# Browser origins allowed to connect (comma-separated), e.g. when the frontend runs on another port.
# VOICE_ENGINE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
